}

// ── BUILD CSV 1: INVENTORY QUANTITIES ────────────────────────────────────
// Shopify Inventory Import format (Admin → Products → Inventory → Import)
// Required columns: Handle, SKU or Option cols, Location as “On hand (new)” header
// Safe: only updates quantities, never deletes variants
const qtyHeaders = [‘Handle’,‘Title’,‘Option1 Name’,‘Option1 Value’,‘Option2 Name’,‘Option2 Value’,‘Option3 Name’,‘Option3 Value’,‘SKU’, locationName];
let qtyCSV = qtyHeaders.map(escCSV).join(’,’) + ‘\n’;
for (const r of outputRows) {
const sr = r.shopifyRow || {};
qtyCSV += [
r.handle,
r.title || sr[‘Title’] || ‘’,
r.opt1Name || sr[‘Option1 Name’] || ‘’,
sr[‘Option1 Value’] || ‘’,
r.opt2Name || sr[‘Option2 Name’] || ‘’,
sr[‘Option2 Value’] || ‘’,
sr[‘Option3 Name’] || ‘’,
sr[‘Option3 Value’] || ‘’,
r.sku,
r.qty
].map(escCSV).join(’,’) + ‘\n’;
}

// ── BUILD CSV 2: PRICES ───────────────────────────────────────────────────
// Format: full product structure with ALL variants per touched product
// Must include every variant for any product that appears, to prevent Shopify
// from deleting unmentioned variants on Products → Import
// import via Admin → Products → Import with “Overwrite existing products” checked

// Build price lookup: sku → price
const priceMap = {};
for (const r of outputRows) {
if (r.price != null) priceMap[r.sku] = r.price;
}

// Find all handles that have at least one price update
const touchedHandles = new Set(outputRows.filter(r => r.price != null).map(r => r.handle));

// Build price CSV — include ALL variant rows from Shopify for touched handles
const priceHeaders = [‘Handle’,‘Title’,‘Option1 Name’,‘Option1 Value’,‘Option2 Name’,‘Option2 Value’,‘Option3 Name’,‘Option3 Value’,‘Variant SKU’,‘Variant Price’];
let priceCSV = priceHeaders.map(escCSV).join(’,’) + ‘\n’;

for (const row of shopifyData) {
const handle = row[‘Handle’] || ‘’;
const sku    = row[‘Variant SKU’] || ‘’;
if (!touchedHandles.has(handle)) continue;
const meta = handleMeta[handle] || {};
const price = priceMap[sku];
priceCSV += [
handle,
row[‘Title’] || ‘’,
meta.opt1Name || row[‘Option1 Name’] || ‘’,
row[‘Option1 Value’] || ‘’,
meta.opt2Name || row[‘Option2 Name’] || ‘’,
row[‘Option2 Value’] || ‘’,
row[‘Option3 Name’] || ‘’,
row[‘Option3 Value’] || ‘’,
sku,
price != null ? price.toFixed(2) : (row[‘Variant Price’] || ‘0.00’)
].map(escCSV).join(’,’) + ‘\n’;
}

// ── UPDATE UI ─────────────────────────────────────────────────────────────
document.getElementById(‘stat-updated’).textContent = countUpdated;
document.getElementById(‘stat-warned’).textContent  = countWarned;
document.getElementById(‘stat-skipped’).textContent = countSkipped;
document.getElementById(‘stat-total’).textContent   = collectrData.length;

const logBox = document.getElementById(‘logBox’);
logBox.innerHTML = logLines.join(’\n’);
logBox.scrollTop = logBox.scrollHeight;

const date = new Date().toISOString().slice(0,10);
const dlArea = document.getElementById(‘download-area’);
if (countUpdated > 0) {
const qtyBlob  = new Blob([qtyCSV],   {type:‘text/csv’});
const priceBlob = new Blob([priceCSV], {type:‘text/csv’});
const qtyUrl   = URL.createObjectURL(qtyBlob);
const priceUrl = URL.createObjectURL(priceBlob);
dlArea.innerHTML = ` <div class="download-grid"> <a class="btn-download qty" href="${qtyUrl}" download="inventory-quantities-${date}.csv">⬇ Inventory CSV<br><small style="font-size:11px;opacity:0.8;">${countUpdated} variants · Inventory Import</small></a> <a class="btn-download price" href="${priceUrl}" download="inventory-prices-${date}.csv">⬇ Price CSV<br><small style="font-size:11px;opacity:0.8;">${touchedHandles.size} products · Products Import</small></a> </div> <div class="download-instructions"> <strong>① Inventory CSV</strong> Admin → Products → Inventory → Import — updates quantities only, safe to use anytime. <strong style="margin-top:10px;">② Price CSV</strong> Admin → Products → Import → overwrite existing — updates prices. Includes all variants per product so nothing gets deleted. </div>`;
} else {
dlArea.innerHTML = `<p style="color:var(--warning);margin-top:12px;">No matched variants — check set mappings and confirm both files are correct.</p>`;
}
}
