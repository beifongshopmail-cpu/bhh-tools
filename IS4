  .upload-zone.loaded { border-color: var(--success); border-style: solid; background: rgba(76,175,130,0.05); }
  .upload-zone input[type="file"] { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; padding: 0; border: none; }
  .upload-icon { font-size: 28px; margin-bottom: 10px; }
  .upload-label { font-family: 'Cinzel', serif; font-size: 12px; letter-spacing: 1.5px; color: var(--accent); text-transform: uppercase; margin-bottom: 6px; }
  .upload-sub { font-size: 12px; color: var(--text-dim); }
  .upload-filename { font-size: 13px; color: var(--success); margin-top: 6px; font-weight: 600; word-break: break-all; }
  .btn-process { width: 100%; padding: 16px; background: linear-gradient(135deg, #c8a84b, #a8862e); border: none; border-radius: 6px; color: #0a0c12; font-family: 'Cinzel', serif; font-size: 15px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; cursor: pointer; transition: all 0.25s; margin-top: 4px; }
  .btn-process:hover:not(:disabled) { background: linear-gradient(135deg, #dbb84f, #c8a84b); transform: translateY(-1px); box-shadow: 0 6px 20px rgba(200,168,75,0.3); }
  .btn-process:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
  .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 20px; }
  @media (max-width: 500px) { .stats-grid { grid-template-columns: repeat(2, 1fr); } }
  .stat { background: var(--surface2); border: 1px solid var(--border); border-radius: 6px; padding: 16px 12px; text-align: center; }
  .stat-value { font-family: 'Cinzel', serif; font-size: 26px; font-weight: 700; line-height: 1; margin-bottom: 6px; }
  .stat-label { font-size: 11px; letter-spacing: 1px; color: var(--text-dim); text-transform: uppercase; }
  .stat.updated .stat-value { color: var(--success); }
  .stat.warned .stat-value { color: var(--warning); }
  .stat.skipped .stat-value { color: var(--text-dim); }
  .stat.total .stat-value { color: var(--rift); }
  .log-box { background: #070910; border: 1px solid var(--border); border-radius: 6px; padding: 16px; max-height: 320px; overflow-y: auto; font-family: 'Courier New', monospace; font-size: 12px; line-height: 1.7; }
  .log-ok { color: var(--success); } .log-warn { color: var(--warning); } .log-skip { color: var(--text-dim); } .log-error { color: var(--error); } .log-info { color: var(--rift); }
  .btn-download { display: inline-flex; align-items: center; gap: 10px; border-radius: 6px; padding: 12px 24px; font-family: 'Cinzel', serif; font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; cursor: pointer; text-decoration: none; transition: all 0.2s; margin-top: 12px; width: 100%; justify-content: center; }
  .btn-download.qty { background: linear-gradient(135deg, rgba(76,175,130,0.2), rgba(76,175,130,0.1)); border: 1px solid rgba(76,175,130,0.4); color: var(--success); }
  .btn-download.qty:hover { background: linear-gradient(135deg, rgba(76,175,130,0.3), rgba(76,175,130,0.18)); border-color: var(--success); transform: translateY(-1px); }
  .btn-download.price { background: linear-gradient(135deg, rgba(91,141,238,0.2), rgba(91,141,238,0.1)); border: 1px solid rgba(91,141,238,0.4); color: var(--rift); }
  .btn-download.price:hover { background: linear-gradient(135deg, rgba(91,141,238,0.3), rgba(91,141,238,0.18)); border-color: var(--rift); transform: translateY(-1px); }
  .download-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
  @media (max-width: 600px) { .download-grid { grid-template-columns: 1fr; } }
  .download-instructions { background: rgba(200,168,75,0.07); border: 1px solid rgba(200,168,75,0.2); border-radius: 6px; padding: 14px 18px; margin-top: 14px; font-size: 13px; line-height: 1.7; color: var(--text-dim); }
  .download-instructions strong { color: var(--accent); display: block; margin-bottom: 4px; }
  .section-divider { height: 1px; background: var(--border); margin: 24px 0; }
  .hidden { display: none; }
  #results { margin-top: 8px; }
  .log-box::-webkit-scrollbar { width: 6px; }
  .log-box::-webkit-scrollbar-track { background: transparent; }
  .log-box::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
</style>
