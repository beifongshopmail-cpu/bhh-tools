if (!match) {
  // Try token fallback: Collectr "271/298" → tokenIndex key "OGN-271298"
  const tokenKey = `${setCode}-${cardNum.replace('/', '')}`;
  match = tokenIndex[tokenKey];
  if (match) {
    logAdd('log-info', `TOKEN   ${tokenKey} → ${match.sku} | "${productName}"`);
