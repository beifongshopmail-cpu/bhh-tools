// Always skip non-Riftbound
if (category !== 'Riftbound') { logAdd('log-skip', `SKIP [non-Riftbound] ${productName}`); countSkipped++; continue; }

// Skip excluded portfolios
if (excludeList.length > 0 && excludeList.includes(portfolio)) {
  logAdd('log-skip', `SKIP [excluded portfolio] ${portfolio}`);
  countSkipped++; continue;
}

// Skip sealed (no card number)
if (!cardNum) {
  logAdd('log-warn', `WARN [sealed/no card number] "${productName}" | ${setName}`);
  countWarned++; continue;
}

// Map set name to code
const setCode = setMap[setName];
if (!setCode) {
  logAdd('log-warn', `WARN [unmapped set] "${setName}" → ${productName} ${cardNum}`);
  countWarned++; continue;
}

// Build target SKU — always NMM condition (selling stock is always NM)
const numPart  = cardNum.replace('/', 'of');
const printing = (variance === 'Foil') ? 'FOIL' : 'NORMAL';

let targetSku;
if (PROMO_SETS.has(setName)) {
  // Detect actual set code from card number total
  let promoCode = promoTotalMap['default'];
  const totalMatch = cardNum.match(/\/(\d+)$/);
  if (totalMatch) {
    const total = totalMatch[1].replace(/^0+/,'') || '0';
    promoCode = promoTotalMap[total] || promoTotalMap['default'];
  } else {
    const runeMatch = cardNum.match(/^R\d+([a-z]+)$/i);
    if (runeMatch) promoCode = runeSuffixMap[runeMatch[1].toLowerCase()] || promoTotalMap['default'];
  }
  targetSku = `${promoCode}-${numPart}-PROMO-FOIL-NMM`;
} else {
  targetSku = `${setCode}-${numPart}-${printing}-NMM`;
