<script>
// ── CSV PARSER ────────────────────────────────────────────────────────────────
function parseCSV(text) {
  const rows = [];
  let i = 0, n = text.length;
  while (i < n) {
    const row = [];
    while (i < n && text[i] !== '\n') {
      if (text[i] === '"') {
        i++; let val = '';
        while (i < n) {
          if (text[i] === '"' && text[i+1] === '"') { val += '"'; i += 2; }
          else if (text[i] === '"') { i++; break; }
          else { val += text[i++]; }
        }
        row.push(val);
        if (text[i] === ',') i++;
      } else {
        let val = '';
        while (i < n && text[i] !== ',' && text[i] !== '\n') val += text[i++];
        row.push(val.trim());
        if (text[i] === ',') i++;
      }
    }
    if (text[i] === '\n') i++;
    if (row.some(c => c !== '')) rows.push(row);
  }
  if (rows.length < 2) return [];
  const headers = rows[0];
  return rows.slice(1).map(r => {
    const obj = {};
    headers.forEach((h, idx) => obj[h.trim()] = (r[idx] || '').trim());
    return obj;
  });
}

function escCSV(v) {
v = String(v == null ? ‘’ : v);
if (v.includes(’,’) || v.includes(’”’) || v.includes(’\n’)) return ‘”’ + v.replace(/”/g,’””’) + ‘”’;
return v;
}

// ── STATE ─────────────────────────────────────────────────────────────────────
let collectrData = null, shopifyData = null;
let logLines = [];

// ── SET MAPPINGS ──────────────────────────────────────────────────────────────
const PROMO_SETS = new Set([
‘Riftbound Organized Play Promotional Cards’,
‘Riftbound Promotional Cards’,
]);

const defaultMappings = [
{ collectr: ‘Origins’,                                      shopify: ‘OGN’ },
{ collectr: ‘Spiritforged’,                                 shopify: ‘SFD’ },
{ collectr: ‘Origins: Proving Grounds’,                     shopify: ‘OGS’ },
{ collectr: ‘Riftbound Organized Play Promotional Cards’,   shopify: ‘PROMO’ },
{ collectr: ‘Riftbound Promotional Cards’,                  shopify: ‘PROMO’ },
];

function getMappings() {
return window._mappings || (window._mappings = defaultMappings.map(m => ({…m})));
}
function renderMappings() {
document.getElementById(‘setMappings’).innerHTML = getMappings().map((m, i) => ` <div class="set-map-row"> <input type="text" value="${m.collectr}" placeholder="Collectr set name" data-mi="${i}" data-side="collectr" oninput="updateMapping(this)"> <div class="set-map-arrow">→</div> <input type="text" value="${m.shopify}" placeholder="Set code" data-mi="${i}" data-side="shopify" oninput="updateMapping(this)"> <button class="btn-icon" onclick="removeMapping(${i})">×</button> </div>`).join(’’);
}
function addMapping() { getMappings().push({collectr:’’,shopify:’’}); renderMappings(); }
function removeMapping(i) { getMappings().splice(i,1); renderMappings(); }
function updateMapping(el) { getMappings()[el.dataset.mi][el.dataset.side] = el.value; }

// ── RUNE SUFFIX MAP ───────────────────────────────────────────────────────────
const defaultRuneSuffixes = [{ suffix: ‘b’, code: ‘SFD’ }];
function getRuneSuffixes() {
return window._runeSuffixes || (window._runeSuffixes = defaultRuneSuffixes.map(r => ({…r})));
}
function renderRuneSuffixes() {
const el = document.getElementById(‘runeSuffixMappings’);
if (!el) return;
el.innerHTML = getRuneSuffixes().map((s, i) => ` <div style="display:grid;grid-template-columns:80px 40px 1fr 36px;gap:8px;align-items:center;margin-bottom:10px;"> <input type="text" value="${s.suffix}" placeholder="b" maxlength="4" data-ri="${i}" data-side="suffix" oninput="updateRuneSuffix(this)" style="text-align:center;font-family:monospace;"> <div style="text-align:center;color:var(--accent);font-size:18px;">→</div> <input type="text" value="${s.code}" placeholder="SFD" maxlength="10" data-ri="${i}" data-side="code" oninput="updateRuneSuffix(this)"> <button class="btn-icon" onclick="removeRuneSuffix(${i})">×</button> </div>`).join(’’);
}
function addRuneSuffix() { getRuneSuffixes().push({suffix:’’,code:’’}); renderRuneSuffixes(); }
function removeRuneSuffix(i) { getRuneSuffixes().splice(i,1); renderRuneSuffixes(); }
function updateRuneSuffix(el) { getRuneSuffixes()[el.dataset.ri][el.dataset.side] = el.value; }
function getRuneSuffixMap() {
return Object.fromEntries(getRuneSuffixes().filter(r=>r.suffix&&r.code).map(r=>[r.suffix.toLowerCase(),r.code.toUpperCase()]));
}

// Init UI
renderMappings();
renderRuneSuffixes();

// ── FILE HANDLING ─────────────────────────────────────────────────────────────
function handleFile(type, input) {
const file = input.files[0];
if (!file) return;
const zone = document.getElementById(‘zone-’ + type);
const nameEl = document.getElementById(‘name-’ + type);
const reader = new FileReader();
reader.onload = e => {
const data = parseCSV(e.target.result);
if (type === ‘collectr’) collectrData = data;
else shopifyData = data;
zone.classList.add(‘loaded’);
nameEl.textContent = `✓ ${file.name} (${data.length} rows)`;
checkReady();
};
reader.readAsText(file);
}

[‘collectr’,‘shopify’].forEach(type => {
const zone = document.getElementById(‘zone-’ + type);
zone.addEventListener(‘dragover’, e => { e.preventDefault(); zone.classList.add(‘drag-over’); });
zone.addEventListener(‘dragleave’, () => zone.classList.remove(‘drag-over’));
zone.addEventListener(‘drop’, e => {
e.preventDefault(); zone.classList.remove(‘drag-over’);
const file = e.dataTransfer.files[0];
if (!file) return;
const inp = document.getElementById(‘file-’ + type);
const dt = new DataTransfer(); dt.items.add(file); inp.files = dt.files;
handleFile(type, inp);
});
});

function checkReady() {
document.getElementById(‘btn-run’).disabled = !(collectrData && shopifyData);
}

// ── PRICING ───────────────────────────────────────────────────────────────────
function roundPrice(raw) {
if (!raw || isNaN(raw) || raw <= 0) return null;
if (raw < 1.00) return Math.ceil(raw * 4) / 4;   // nearest $0.25
return Math.ceil(raw * 2) / 2;                    // nearest $0.50
}

function getPrice(row) {
const override = parseFloat(row[‘Price Override’]);
if (override && override > 0) return roundPrice(override);
// Market Price column includes export date, e.g. “Market Price (As of 2026-02-27)”
const marketEntry = Object.entries(row).find(([k]) => k.startsWith(‘Market Price’));
const market = parseFloat(marketEntry?.[1] || ‘0’);
return roundPrice(market);
}

// ── LOGGING ───────────────────────────────────────────────────────────────────
function logAdd(cls, msg) { logLines.push(`<span class="${cls}">${msg}</span>`); }

// ── MAIN SYNC ─────────────────────────────────────────────────────────────────
function runSync() {
logLines = [];
document.getElementById(‘results’).classList.remove(‘hidden’);
document.getElementById(‘logBox’).innerHTML = ‘’;

const locationName = document.getElementById(‘locationName’).value.trim() || ‘Beifong's Hit-House’;
const excludeList  = document.getElementById(‘portfolioExclude’).value
.split(’,’).map(s => s.trim()).filter(Boolean);

// Build set map
const setMap = {};
getMappings().forEach(m => { if (m.collectr && m.shopify) setMap[m.collectr.trim()] = m.shopify.trim().toUpperCase(); });

// Build promo total → set code map from UI
const promoTotalMap = {
‘298’:    document.getElementById(‘promoMap298’).value.trim()    || ‘OGN’,
‘221’:    document.getElementById(‘promoMap221’).value.trim()    || ‘SFD’,
‘24’:     document.getElementById(‘promoMap024’).value.trim()    || ‘OGS’,
‘default’:document.getElementById(‘promoMapDefault’).value.trim() || ‘OGN’,
};
const runeSuffixMap = getRuneSuffixMap();

// ── INDEX SHOPIFY VARIANTS ────────────────────────────────────────────────
// Build handle → { title, opt1Name, opt2Name } — these only appear on first variant row
const handleMeta = {};
for (const row of shopifyData) {
const handle = row[‘Handle’] || ‘’;
if (!handle) continue;
if (!handleMeta[handle]) {
handleMeta[handle] = { title: row[‘Title’]||’’, opt1Name: row[‘Option1 Name’]||’’, opt2Name: row[‘Option2 Name’]||’’ };
} else {
// Fill in blanks from subsequent rows
if (!handleMeta[handle].title    && row[‘Title’])         handleMeta[handle].title    = row[‘Title’];
if (!handleMeta[handle].opt1Name && row[‘Option1 Name’])  handleMeta[handle].opt1Name = row[‘Option1 Name’];
if (!handleMeta[handle].opt2Name && row[‘Option2 Name’])  handleMeta[handle].opt2Name = row[‘Option2 Name’];
}
}

// Index all variants by SKU
// Also build a secondary token index: “{SETCODE}-{numPart}” → token entry
// Token handles follow pattern: “ogn-271298-recruit-271-buff” → setcode OGN, num 271of298
const shopifyIndex = {};
const tokenIndex = {};
let shopifyVariantCount = 0;
for (const row of shopifyData) {
const handle = row[‘Handle’] || ‘’;
const sku    = row[‘Variant SKU’] || ‘’;
if (!handle || !sku) continue;
shopifyVariantCount++;
const meta = handleMeta[handle] || {};
const entry = { handle, sku, title: meta.title, opt1Name: meta.opt1Name, opt2Name: meta.opt2Name, row };
shopifyIndex[sku] = entry;
// Build token index from TOKEN SKUs: OGN-TOKEN-662994 on handle ogn-271298-…
if (sku.includes(’-TOKEN-’)) {
// Extract set code from SKU prefix
const setCode = sku.split(’-’)[0];
// Extract card number from handle: “ogn-271298-…” → “271298” → “271of298”
const handleParts = handle.split(’-’);
if (handleParts.length >= 2) {
const numRaw = handleParts[1]; // e.g. “271298”
// Try to match against known set totals to reconstruct “271of298”
// We’ll just store by setcode+numRaw for lookup
tokenIndex[`${setCode.toUpperCase()}-${numRaw}`] = entry;
}
}
}
logAdd(‘log-info’, `Indexed ${shopifyVariantCount} Shopify variants`);

// ── PROCESS COLLECTR ROWS ─────────────────────────────────────────────────
let countUpdated = 0, countWarned = 0, countSkipped = 0;
const outputRows = [];

for (const row of collectrData) {
const portfolio   = row[‘Portfolio Name’] || ‘’;
const category    = row[‘Category’] || ‘’;
const setName     = row[‘Set’] || ‘’;
const productName = (row[‘Product Name’] || ‘’).trim();
const cardNum     = (row[‘Card Number’] || ‘’).trim();
const variance    = (row[‘Variance’] || ‘’).trim();
const qty         = parseInt(row[‘Quantity’] || ‘0’, 10);

